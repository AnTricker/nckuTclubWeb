# Local Environment Variables (git-ignored)
# Copy this file to .env.local and update with your own values
# This file is NOT committed to git

# N8N Webhook URL
VITE_N8N_WEBHOOK_URL=YOUR_N8N_WEBHOOK_URL_HERE

# App name (optional - overrides default)
# VITE_APP_NAME=成大Tricking社課報名

# Debug logging
VITE_DEBUG=true
